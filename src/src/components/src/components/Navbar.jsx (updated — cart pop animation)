import { IceCreamCone, Menu, ShoppingCart, X } from 'lucide-react';
import { useEffect, useRef, useState } from 'react';

const navItems = [
  { label: 'Home', href: '#home' },
  { label: 'Flavors', href: '#flavors' },
  { label: 'Menu', href: '#menu' },
  { label: 'About', href: '#about' },
  { label: 'Gallery', href: '#gallery' },
  { label: 'Contact', href: '#contact' },
];

const Navbar = ({ itemCount = 0 }) => {
  const [menuOpen, setMenuOpen] = useState(false);
  const badgeRef = useRef(null);
  const prevCount = useRef(itemCount);

  useEffect(() => {
    if (itemCount > 0 && prevCount.current !== itemCount) {
      const el = badgeRef.current;
      if (el) {
        el.classList.remove('pop');
        // force reflow
        void el.offsetWidth;
        el.classList.add('pop');
      }
    }
    prevCount.current = itemCount;
  }, [itemCount]);

  const handleLinkClick = () => setMenuOpen(false);

  return (
    <header className="sticky top-0 z-50 border-b border-brown/10 bg-[#FFF8E7]/90 backdrop-blur-md">
      <nav className="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <a href="#home" className="flex items-center gap-3">
          <div className="flex h-11 w-11 items-center justify-center rounded-full bg-gradient-to-br from-pink to-[#FFD8E5] text-white shadow-soft">
            <IceCreamCone size={22} />
          </div>
          <div>
            <p className="text-xl font-extrabold tracking-tight text-brown">
              Dreamy Scoops
            </p>
          </div>
        </a>

        <div className="hidden items-center gap-7 md:flex">
          {navItems.map((item) => (
            <a key={item.label} href={item.href} className="menu-link">
              {item.label}
            </a>
          ))}
        </div>

        <div className="hidden items-center gap-4 md:flex">
          <button
            type="button"
            className="relative flex h-11 w-11 items-center justify-center rounded-full border border-brown/10 bg-white text-brown shadow-sm transition hover:scale-105"
            aria-label="Open cart"
          >
            <ShoppingCart size={18} />
            {itemCount > 0 && (
              <span
                ref={badgeRef}
                className="absolute -right-1 -top-1 flex h-5 min-w-[20px] items-center justify-center rounded-full bg-pink px-1 text-[10px] font-bold text-white transition-transform"
              >
                {itemCount}
              </span>
            )}
          </button>

          <a href="#flavors" className="btn-primary">
            Order Now
          </a>
        </div>

        <button
          type="button"
          className="flex h-11 w-11 items-center justify-center rounded-full border border-brown/10 bg-white text-brown md:hidden"
          onClick={() => setMenuOpen((prev) => !prev)}
          aria-label="Toggle menu"
        >
          {menuOpen ? <X size={22} /> : <Menu size={22} />}
        </button>
      </nav>

      {menuOpen && (
        <div className="border-t border-brown/10 bg-white md:hidden">
          <div className="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-5">
            {navItems.map((item) => (
              <a
                key={item.label}
                href={item.href}
                className="text-base font-medium text-brown/80 transition hover:text-pink"
                onClick={handleLinkClick}
              >
                {item.label}
              </a>
            ))}

            <div className="flex items-center justify-between gap-4 pt-3">
              <div className="flex items-center gap-3">
                <div className="relative flex h-10 w-10 items-center justify-center rounded-full bg-white text-brown shadow-sm">
                  <ShoppingCart size={18} />
                  {itemCount > 0 && (
                    <span className="absolute -right-2 -top-1 flex h-5 min-w-[20px] items-center justify-center rounded-full bg-pink px-1 text-[10px] font-bold text-white">
                      {itemCount}
                    </span>
                  )}
                </div>
                <span className="text-sm font-medium text-brown/80">
                  Cart ({itemCount})
                </span>
              </div>

              <a href="#flavors" className="btn-primary" onClick={handleLinkClick}>
                Order Now
              </a>
            </div>
          </div>
        </div>
      )}
    </header>
  );
};

export default Navbar;
