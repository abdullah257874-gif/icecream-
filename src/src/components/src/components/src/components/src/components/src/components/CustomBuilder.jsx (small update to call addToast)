import { useMemo, useState } from 'react';
import { Plus, Sparkles } from 'lucide-react';

const coneOptions = ['Cup', 'Waffle Cone'];
const scoopOptions = [1, 2, 3];
const flavorOptions = ['Strawberry', 'Chocolate', 'Vanilla', 'Mango', 'Mint'];
const toppingOptions = ['Sprinkles', 'Chocolate Chips', 'Caramel', 'Strawberry Syrup'];

const CustomBuilder = ({ onAddToCart, addToast }) => {
  const [coneType, setConeType] = useState('Cup');
  const [scoops, setScoops] = useState(2);
  const [flavor, setFlavor] = useState('Strawberry');
  const [selectedToppings, setSelectedToppings] = useState([
    'Sprinkles',
    'Caramel',
  ]);

  const price = useMemo(() => {
    let total = coneType === 'Waffle Cone' ? 1.5 : 0.75;
    total += scoops === 1 ? 3.5 : scoops === 2 ? 5.25 : 7.0;
    total +=
      flavor === 'Strawberry'
        ? 0.5
        : flavor === 'Chocolate'
          ? 0.75
          : flavor === 'Vanilla'
            ? 0.4
            : flavor === 'Mango'
              ? 0.65
              : 0.7;

    total += selectedToppings.length * 0.75;
    return Number(total.toFixed(2));
  }, [coneType, scoops, flavor, selectedToppings]);

  const toggleTopping = (topping) => {
    setSelectedToppings((prev) =>
      prev.includes(topping)
        ? prev.filter((item) => item !== topping)
        : [...prev, topping]
    );
  };

  const handleAddCustom = () => {
    const product = {
      id: `custom-${Date.now()}`,
      name: `${scoops}-Scoop ${coneType} • ${flavor}`,
      price: price,
      image:
        'https://images.unsplash.com/photo-1563805042-7684c019e1cb?auto=format&fit=crop&w=1200&q=80',
      description: `${selectedToppings.join(', ') || 'Classic'} topping combo`,
      custom: true,
    };
    onAddToCart(product);
    if (addToast) addToast('Custom ice cream added to cart');
  };

  return (
    <div className="soft-card bg-white p-6 sm:p-8">
      <div className="mb-6 flex items-center justify-between gap-3">
        <div>
          <span className="tag">Custom Build</span>
          <h3 className="mt-3 text-3xl font-extrabold text-brown">
            Build Your Dream Scoop
          </h3>
        </div>

        <div className="rounded-2xl bg-[#FFF1F5] px-4 py-3 text-right">
          <p className="text-xs uppercase tracking-[0.12em] text-brown/70">Total</p>
          <p className="text-2xl font-extrabold text-brown">${price.toFixed(2)}</p>
        </div>
      </div>

      <div className="space-y-8">
        <div>
          <label className="mb-3 block text-sm font-semibold uppercase tracking-[0.12em] text-brown/70">
            Choose your container
          </label>
          <div className="flex flex-wrap gap-3">
            {coneOptions.map((option) => (
              <button
                key={option}
                type="button"
                className={`rounded-full px-4 py-2.5 text-sm font-semibold transition ${
                  coneType === option
                    ? 'bg-brown text-white shadow-soft'
                    : 'bg-[#F8F3F1] text-brown hover:bg-[#F1E7E4]'
                }`}
                onClick={() => setConeType(option)}
              >
                {option}
              </button>
            ))}
          </div>
        </div>

        <div>
          <label className="mb-3 block text-sm font-semibold uppercase tracking-[0.12em] text-brown/70">
            Number of scoops
          </label>
          <div className="flex flex-wrap gap-3">
            {scoopOptions.map((option) => (
              <button
                key={option}
                type="button"
                className={`flex h-12 w-12 items-center justify-center rounded-full text-sm font-semibold transition ${
                  scoops === option
                    ? 'bg-pink text-white shadow-soft'
                    : 'bg-[#F8F3F1] text-brown hover:bg-[#F1E7E4]'
                }`}
                onClick={() => setScoops(option)}
              >
                {option}
              </button>
            ))}
          </div>
        </div>

        <div>
          <label className="mb-3 block text-sm font-semibold uppercase tracking-[0.12em] text-brown/70">
            Pick a flavor
          </label>
          <div className="flex flex-wrap gap-3">
            {flavorOptions.map((option) => (
              <button
                key={option}
                type="button"
                className={`rounded-full px-4 py-2.5 text-sm font-semibold transition ${
                  flavor === option
                    ? 'bg-mint text-brown shadow-soft'
                    : 'bg-[#F8F3F1] text-brown hover:bg-[#F1E7E4]'
                }`}
                onClick={() => setFlavor(option)}
              >
                {option}
              </button>
            ))}
          </div>
        </div>

        <div>
          <label className="mb-3 block text-sm font-semibold uppercase tracking-[0.12em] text-brown/70">
            Add toppings
          </label>
          <div className="flex flex-wrap gap-3">
            {toppingOptions.map((option) => (
              <button
                key={option}
                type="button"
                className={`rounded-full px-4 py-2.5 text-sm font-semibold transition ${
                  selectedToppings.includes(option)
                    ? 'bg-lavender text-brown shadow-soft'
                    : 'bg-[#F8F3F1] text-brown hover:bg-[#F1E7E4]'
                }`}
                onClick={() => toggleTopping(option)}
              >
                {option}
              </button>
            ))}
          </div>
        </div>

        <div className="rounded-[24px] bg-[#FFF9EC] p-4">
          <div className="flex items-start justify-between gap-4">
            <div>
              <p className="text-sm font-semibold uppercase tracking-[0.12em] text-brown/70">
                Your custom creation
              </p>
              <p className="mt-2 text-lg font-bold text-brown">
                {scoops}-scoop {coneType.toLowerCase()} • {flavor}
              </p>
              <p className="mt-1 text-sm text-brown/70">
                {selectedToppings.length > 0
                  ? selectedToppings.join(', ')
                  : 'No extra toppings'}
              </p>
            </div>

            <div className="flex h-10 w-10 items-center justify-center rounded-full bg-pink text-white">
              <Sparkles size={18} />
            </div>
          </div>
        </div>

        <button
          type="button"
          onClick={handleAddCustom}
          className="inline-flex w-full items-center justify-center gap-2 rounded-full bg-pink px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:shadow-lg"
        >
          <Plus size={18} />
          Add Custom Ice Cream to Cart
        </button>
      </div>
    </div>
  );
};

export default CustomBuilder;
